# Dev Dockerfile: lightweight image with Spring Boot Devtools + Vite HMR
# Source volumes are mounted at runtime (see docker-compose.dev.yaml).

FROM gradle:9.7.1-jdk25 AS backend-build

WORKDIR /workspace
COPY gradle gradle
COPY gradlew build.gradle settings.gradle ./
RUN ./gradlew --no-daemon dependencies
COPY src src
RUN ./gradlew --no-daemon bootJar -x buildFrontend -x npmInstall -x spotlessCheck -x test

FROM eclipse-temurin:25-jre

# curl for healthcheck
RUN apt-get update && apt-get install --no-install-recommends -y curl \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system app && useradd --system --gid app app

# The bootJar as the runtime base (mounted classes override it)
COPY --from=backend-build /workspace/build/libs/*.jar /app/app.jar

RUN mkdir -p /workspace/classes /workspace/resources && chown -R app:app /workspace

USER app
WORKDIR /app

EXPOSE 8080 5173

ENTRYPOINT ["java", \
  "-XX:MaxRAMPercentage=60", \
  "-Dspring.devtools.restart.enabled=true", \
  "-Dspring.devtools.restart.additional-paths=/workspace/classes:/workspace/resources", \
  "-Dspring.devtools.restart.poll-interval=1s", \
  "-Dspring.devtools.restart.quiet-period=500ms", \
  "-jar", "/app/app.jar"]
