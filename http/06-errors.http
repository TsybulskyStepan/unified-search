### Errors — every failure is an RFC 9457 problem document.
# type, title, status, detail, instance, and an errors map when fields are invalid.
# No stack traces, SQL or constraint names are ever exposed.

@baseUrl = http://localhost:8080
@apiKey = dev-only-insecure-key-do-not-use-in-production-env

### No API key. Expect 401.
GET {{baseUrl}}/search?q=anything

### Wrong API key. Expect 401, the same response as no key.
GET {{baseUrl}}/search?q=anything
X-API-Key: not-the-right-key

### Missing q. Expect 400 with errors.q.
GET {{baseUrl}}/search
X-API-Key: {{apiKey}}

### Blank q. Expect 400.
GET {{baseUrl}}/search?q=
X-API-Key: {{apiKey}}

### limit above the maximum of 50. Expect 400 with errors.limit.
GET {{baseUrl}}/search?q=bill&limit=51
X-API-Key: {{apiKey}}

### Negative offset. Expect 400 with errors.offset.
GET {{baseUrl}}/search?q=bill&offset=-1
X-API-Key: {{apiKey}}

### Non-numeric limit. Expect 400.
GET {{baseUrl}}/search?q=bill&limit=abc
X-API-Key: {{apiKey}}

### Missing required client fields. Expect 400 listing all three.
POST {{baseUrl}}/clients
X-API-Key: {{apiKey}}
Content-Type: application/json

{}

### Malformed email. Expect 400 with errors.email.
POST {{baseUrl}}/clients
X-API-Key: {{apiKey}}
Content-Type: application/json

{
  "first_name": "Ada",
  "last_name": "Lovelace",
  "email": "not-an-email"
}

### Duplicate email. Expect 409 Conflict.
# john.doe@neviswealth.com is in the seeded corpus.
POST {{baseUrl}}/clients
X-API-Key: {{apiKey}}
Content-Type: application/json

{
  "first_name": "John",
  "last_name": "Doe",
  "email": "john.doe@neviswealth.com"
}

### Malformed JSON body. Expect 400, with no parser internals in the response.
POST {{baseUrl}}/clients
X-API-Key: {{apiKey}}
Content-Type: application/json

{"first_name":

### Unknown client. Expect 404.
GET {{baseUrl}}/clients/11111111-1111-1111-1111-111111111111
X-API-Key: {{apiKey}}

### A document for a client that does not exist. Expect 404.
POST {{baseUrl}}/clients/11111111-1111-1111-1111-111111111111/documents
X-API-Key: {{apiKey}}
Content-Type: application/json

{
  "title": "Orphan",
  "content": "This document has no owner."
}

### A document_type outside the taxonomy. Expect 400 with errors.document_type.
# This needs a real client, since the client is checked before the body.
# Expect 409 here on a second run; the 400 below is the case being demonstrated.
# @name createClient
POST {{baseUrl}}/clients
X-API-Key: {{apiKey}}
Content-Type: application/json

{
  "first_name": "Edge",
  "last_name": "Case",
  "email": "edge.case@example.com"
}

###
POST {{baseUrl}}/clients/{{createClient.response.body.$.id}}/documents
X-API-Key: {{apiKey}}
Content-Type: application/json

{
  "title": "Unclassifiable",
  "content": "The requested type is not in the taxonomy.",
  "document_type": "not_a_real_type"
}

### Wrong method on a real route. Expect 405.
GET {{baseUrl}}/clients
X-API-Key: {{apiKey}}
