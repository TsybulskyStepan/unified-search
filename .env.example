# Optional: docker compose up works without this file — docker-compose.yaml ships a dev-only default.
# Copy this file to .env and set your own value (at least 32 characters) to override it.
API_KEY=replace-this-with-a-random-api-key-of-at-least-32-characters

# Optional: absent by default, so a requested summary resolves to `failed` (§7.3). Set this to a
# real Gemini API key (https://aistudio.google.com/apikey) to turn summaries on.
# GEMINI_API_KEY=

# Optional: defaults to a current Gemini Flash model id. Override if that id is retired.
# SUMMARY_MODEL=
