{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/stepan/Documents/projects/nevis-search-system/.codex/hooks/format-java.sh'",
            "timeout": 60,
            "statusMessage": "Formatting Java"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/stepan/Documents/projects/nevis-search-system/.codex/hooks/verify-build.sh'",
            "timeout": 180,
            "statusMessage": "Verifying build"
          }
        ]
      }
    ]
  }
}
